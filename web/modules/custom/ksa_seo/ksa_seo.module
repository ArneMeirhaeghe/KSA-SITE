<?php

/**
 * @file
 * Pagination glue not provided by Metatag or Views configuration.
 */

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Http\Exception\CacheableNotFoundHttpException;
use Drupal\Core\Url;
use Drupal\views\ViewExecutable;

/** Implements hook_views_post_execute(). */
function ksa_seo_views_post_execute(ViewExecutable $view): void {
  if ($view->id() !== 'news' || $view->current_display !== 'page_1'
    || \Drupal::routeMatch()->getRouteName() !== 'view.news.page_1') {
    return;
  }
  // Read the requested value: Views may have clamped its own current page.
  $value = \Drupal::request()->query->all()['page'] ?? '0';
  $valid = is_scalar($value) && preg_match('/^(0|[1-9][0-9]*)$/D', (string) $value);
  $page_count = max(1, (int) ceil($view->pager->getTotalItems() / max(1, $view->pager->getItemsPerPage())));
  if (!$valid || (float) $value >= $page_count) {
    $cache = (new CacheableMetadata())
      ->setCacheContexts(['url.query_args:page', 'user.permissions', 'user.node_grants:view'])
      ->setCacheTags(['node_list', 'node_list:article', 'config:views.view.news']);
    throw new CacheableNotFoundHttpException($cache, 'Deze nieuwspagina bestaat niet.');
  }
}

/** Implements hook_metatags_alter(). */
function ksa_seo_metatags_alter(array &$metatags, array &$context): void {
  if (\Drupal::routeMatch()->getRouteName() !== 'view.news.page_1') {
    return;
  }
  $value = \Drupal::request()->query->all()['page'] ?? '0';
  $page = is_scalar($value) ? max(0, (int) $value) : 0;
  $url = Url::fromRoute('view.news.page_1', [], [
    'absolute' => TRUE,
    'query' => $page > 0 ? ['page' => $page] : [],
  ])->toString();
  $metatags['canonical_url'] = $url;
  $metatags['og_url'] = $url;
}

/** Implements hook_page_attachments_alter(). */
function ksa_seo_page_attachments_alter(array &$attachments): void {
  if (\Drupal::routeMatch()->getRouteName() === 'view.news.page_1') {
    $attachments['#cache']['contexts'][] = 'url.query_args:page';
  }
}
