<section class="ksa-hero" data-ksa-hero>
  {% set background_markup %}{% block background %}{% endblock %}{% endset %}
  {% if background_markup|trim %}<div class="ksa-hero__background" aria-hidden="true">{{ background_markup }}</div>{% endif %}
  <div class="ksa-hero__intro">
    <h1 class="ksa-hero__heading">{% block heading %}{% endblock %}</h1>
    <div class="ksa-hero__text">{% block intro %}{% endblock %}</div>
  </div>
  {# Jos de vos staat onderaan, vóór de fotokaarten. Zie components/jos. #}
  {{ include('ksa:jos', {}, with_context = false) }}
  <div class="ksa-hero__stage" role="region" aria-roledescription="{{ 'carrousel'|t }}" aria-label="{{ 'KSA-foto’s'|t }}">
    <svg class="ksa-hero__rope" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M-20 18 Q720 95 1460 18"/></svg>
    <div class="ksa-hero__window"><div class="ksa-hero__rail">{% block images %}{% endblock %}</div></div>
  </div>
  <div class="ksa-hero__controls" hidden>
    <button type="button" data-hero-play aria-label="{{ 'Automatisch doorschuiven pauzeren'|t }}">
      <span class="ksa-hero__clock" aria-hidden="true"><svg viewBox="0 0 40 40"><circle class="ksa-hero__track" cx="20" cy="20" r="17"/><circle data-hero-progress cx="20" cy="20" r="17" pathLength="100"/></svg><span data-hero-countdown>5</span></span>
      <span data-hero-label>{{ 'Pauzeren'|t }}</span>
    </button>
  </div>
  <span class="ksa-hero__status" data-hero-status aria-live="polite"></span>
</section>
