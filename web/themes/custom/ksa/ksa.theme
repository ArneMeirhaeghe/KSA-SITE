<?php

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\node\NodeInterface;

/**
 * Implements hook_preprocess_block().
 */
function ksa_preprocess_block(array &$variables): void {
  if (($variables['plugin_id'] ?? '') === 'page_title_block') {
    $variables['is_front'] = \Drupal::service('path.matcher')->isFrontPage();
    CacheableMetadata::createFromRenderArray($variables['content'])
      ->addCacheContexts(['url.path'])
      ->applyTo($variables['content']);
  }
  if (($variables['plugin_id'] ?? '') !== 'system_menu_block:main') {
    return;
  }
  $variables['configuration']['label'] = t('Hoofdnavigatie');
  // A detail page belongs to the same navigation section as its overview.
  $cacheability = CacheableMetadata::createFromRenderArray($variables['content']);
  $cacheability->addCacheContexts(['route']);
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface && in_array($node->bundle(), ['team', 'leader'], TRUE)) {
    $cacheability->addCacheableDependency($node);
    foreach ($variables['content']['#items'] as &$item) {
      $url = $item['url'];
      if ($url->isRouted() && $url->getRouteName() === 'entity.node.canonical' && (int) ($url->getRouteParameters()['node'] ?? 0) === 33) {
        $item['in_active_trail'] = TRUE;
        $item['url'] = clone $url;
        $attributes = $url->getOption('attributes') ?? [];
        $attributes['class'][] = 'is-active';
        $item['url']->setOption('attributes', $attributes);
      }
    }
  }
  $cacheability->applyTo($variables['content']);
}

/**
 * Implements hook_page_attachments_alter().
 *
 * Preloads what the browser otherwise finds late, because it is only
 * referenced from CSS: the font on every page, and the hero illustration on
 * the front page. The paths must stay equal to the url() values in the CSS,
 * or the browser downloads the file twice.
 */
function ksa_page_attachments_alter(array &$attachments): void {
  $url = \Drupal::service('file_url_generator');
  $theme = \Drupal::service('extension.list.theme')->getPath('ksa');
  $attachments['#attached']['html_head_link'][] = [[
    'rel' => 'preload',
    'href' => $url->generateString($theme . '/fonts/inter-latin-var.woff2'),
    'as' => 'font',
    'type' => 'font/woff2',
    'crossorigin' => 'anonymous',
  ]];
  $attachments['#cache']['contexts'][] = 'url.path.is_front';
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $attachments['#attached']['html_head_link'][] = [[
      'rel' => 'preload',
      'href' => $url->generateString($theme . '/assets/ksa-header.webp'),
      'as' => 'image',
      'type' => 'image/webp',
      'fetchpriority' => 'high',
    ]];
  }
}
